generator client {
  provider   = "prisma-client"
  output     = "../app/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== AUTH & USERS ====================

enum Role {
  ADMIN
  ENUMERATOR
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String    @map("password_hash")
  fullName     String?   @map("full_name")
  role         Role
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastLoginAt  DateTime? @map("last_login_at")

  baselineDesa BaselineDesa[]
  petani       Petani[]

  @@map("users")
}

// ==================== MASTER WILAYAH ====================

model WilayahProvinsi {
  kode      String             @id
  nama      String
  kabupaten WilayahKabupaten[]

  @@map("wilayah_provinsi")
}

model WilayahKabupaten {
  kode         String             @id
  nama         String
  provinsiKode String             @map("provinsi_kode")
  provinsi     WilayahProvinsi    @relation(fields: [provinsiKode], references: [kode])
  kecamatan    WilayahKecamatan[]

  @@index([provinsiKode])
  @@map("wilayah_kabupaten")
}

model WilayahKecamatan {
  kode          String           @id
  nama          String
  kabupatenKode String           @map("kabupaten_kode")
  kabupaten     WilayahKabupaten @relation(fields: [kabupatenKode], references: [kode])
  desa          WilayahDesa[]

  @@index([kabupatenKode])
  @@map("wilayah_kecamatan")
}

model WilayahDesa {
  kode          String           @id
  nama          String
  kecamatanKode String           @map("kecamatan_kode")
  kecamatan     WilayahKecamatan @relation(fields: [kecamatanKode], references: [kode])
  baselineDesa  BaselineDesa?
  kelompokTani  KelompokTani[]
  petani        Petani[]

  @@index([kecamatanKode])
  @@map("wilayah_desa")
}

// ==================== BASELINE DESA ====================

enum SatuanTutupan {
  PERSEN
  HA
}

model BaselineDesa {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tahunPendataan Int     @map("tahun_pendataan")
  sumberData     String? @map("sumber_data")

  desaKode String      @unique @map("desa_kode")
  wilayah  WilayahDesa @relation(fields: [desaKode], references: [kode])

  // A – Data Desa / Wilayah
  luasWilayahHa           Float?  @map("luas_wilayah_ha")
  jumlahPenduduk          Int?    @map("jumlah_penduduk")
  jumlahKK                Int?    @map("jumlah_kk")
  jumlahPetaniKopi        Int?    @map("jumlah_petani_kopi")
  luasArealKopiHa         Float?  @map("luas_areal_kopi_ha")
  luasKomoditiLainHa      Float?  @map("luas_komoditi_lain_ha")
  latitude                Float?  @map("latitude")
  longitude               Float?  @map("longitude")
  topografi               String?
  ketinggianMdpl          Float?  @map("ketinggian_mdpl")
  bulanHujan              String? @map("bulan_hujan")
  bulanKering             String? @map("bulan_kering")
  suhuRataRataC           Float?  @map("suhu_rata_rata_c")
  jenisTanah              String? @map("jenis_tanah")
  aksesJalan              String? @map("akses_jalan")
  jarakIbukotaKecamatanKm Float?  @map("jarak_ibukota_kecamatan_km")
  jarakPasarKm            Float?  @map("jarak_pasar_km")
  jarakKonservasiKm       Float?  @map("jarak_konservasi_km")
  luasAPLHa               Float?  @map("luas_apl_ha")
  namaKawasanKonservasi   String? @map("nama_kawasan_konservasi")

  // D – Kondisi Bisnis Kopi
  produktivitasKgHaTahun  Float?  @map("produktivitas_kg_ha_tahun")
  hargaCherryRp           Int?    @map("harga_cherry_rp")
  hargaGreenBeanRpKg      Int?    @map("harga_green_bean_rp_kg")
  pembeliUtama            String? @map("pembeli_utama")
  jumlahPedagangPengumpul Int?    @map("jumlah_pedagang_pengumpul")
  koperasiAktifUnit       Int?    @map("koperasi_aktif_unit")
  eksportir               String?
  industriPengolahan      String? @map("industri_pengolahan")
  permasalahanUtama       String? @map("permasalahan_utama")

  // E – Kondisi Konservasi
  berbatasanKonservasi      Boolean?       @map("berbatasan_konservasi")
  luasPenyanggaHa           Float?         @map("luas_penyangga_ha")
  tutupanHutan              Float?         @map("tutupan_hutan")
  tutupanHutanSatuan        SatuanTutupan? @map("tutupan_hutan_satuan")
  tutupanAgroforestry       Float?         @map("tutupan_agroforestry")
  tutupanAgroforestrySatuan SatuanTutupan? @map("tutupan_agroforestry_satuan")
  rawanLongsor              Boolean?       @map("rawan_longsor")
  lokasiRawanLongsor        String?        @map("lokasi_rawan_longsor")
  rawanErosi                Boolean?       @map("rawan_erosi")
  lokasiRawanErosi          String?        @map("lokasi_rawan_erosi")
  konflikSatwa              Boolean?       @map("konflik_satwa")
  jenisSatwaKonflik         String?        @map("jenis_satwa_konflik")
  praktikKonservasi         String?        @map("praktik_konservasi")

  kebijakan   KebijakanDesa[]
  kelembagaan KelembagaanDesa[]

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String @map("created_by_id")

  @@index([createdById])
  @@map("baseline_desa")
}

enum JenisKebijakan {
  RPJM_DESA
  PERDES_PERTANIAN
  PERDES_PERLINDUNGAN_HUTAN
  PROGRAM_PERKEMBANGAN_KOPI
  PROGRAM_KOPERASI
  PROGRAM_PERHUTANAN_SOSIAL
}

model KebijakanDesa {
  id         String         @id @default(uuid())
  jenis      JenisKebijakan
  ada        Boolean        @default(false)
  keterangan String?
  baseline   BaselineDesa   @relation(fields: [baselineId], references: [id], onDelete: Cascade)
  baselineId String         @map("baseline_id")

  @@unique([baselineId, jenis])
  @@map("kebijakan_desa")
}

enum JenisLembaga {
  KELOMPOK_TANI
  GAPOKTAN
  KOPERASI
  BUMDES
  PENYULUH
  PENDAMPING
}

model KelembagaanDesa {
  id         String       @id @default(uuid())
  jenis      JenisLembaga
  jumlah     Int?
  kondisi    String?
  baseline   BaselineDesa @relation(fields: [baselineId], references: [id], onDelete: Cascade)
  baselineId String       @map("baseline_id")

  @@map("kelembagaan_desa")
}

// ==================== BASELINE PETANI ====================

enum JenisKelamin {
  L
  P
}

enum StatusKepemilikanLahan {
  MS
  SW
  BH
  TA
  L
}

enum SistemBudidaya {
  AF
  MK
}

enum JawabanGap {
  YA
  TIDAK
  KADANG
}

enum SatuanProduksi {
  KG
  SOLUP
  BAMBU
  KALENG
}

enum JenisProdukDijual {
  CHERRY
  GABAH_BASAH
  GABAH_KERING
  GB_WET_HULL
  GB_NATURAL
  GB_HONEY
  GB_FULL_WASH
  GB_WINE
  LAINNYA
}

enum KategoriPasar {
  KOMERSIAL
  KOMERSIAL_BERSERTIFIKAT
  SPECIALTY
  ORGANIK
  LAINNYA
}

enum JenisPraktikGap {
  PEMANGKASAN_KOPI
  PEMANGKASAN_NAUNGAN
  PENGENDALIAN_GULMA
  PEMUPUKAN
  PEREMAJAAN_TANAMAN
  PENGENDALIAN_PBKO
  PENGENDALIAN_KARAT_DAUN
  PESTISIDA_SESUAI_DOSIS
  PENYIMPANAN_PESTISIDA
  TERAS_SENGKEDAN
  COVER_CROP
  RORAK_RESAPAN
  LIMBAH_PULP
  PANEN_SELEKTIF
  SORTASI_CHERRY
  PENJEMURAN_BERSIH
  PENYIMPANAN_HASIL
  TANPA_BAKAR_LAHAN
  TANPA_KIMIA_TERLARANG
  APD_PESTISIDA
  TANPA_PEKERJA_ANAK
}

enum JenisKondisiKebun {
  KEPEMILIKAN_JELAS
  BATAS_KONSERVASI
  BATAS_HUTAN_LINDUNG
  DEKAT_SUNGAI
  DEKAT_MATA_AIR
  POHON_NAUNGAN
  KONSERVASI_TANAH
  PERNAH_BAKAR_LAHAN
  KONFLIK_SATWA
  EROSI_LONGSOR
}

model KelompokTani {
  id        String      @id @default(uuid())
  nama      String
  kode      String?
  desaKode  String      @map("desa_kode")
  desa      WilayahDesa @relation(fields: [desaKode], references: [kode])
  petani    Petani[]
  createdAt DateTime    @default(now()) @map("created_at")

  @@unique([desaKode, kode])
  @@map("kelompok_tani")
}

model Petani {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  kodePetani String? @unique @map("kode_petani")

  // A – Identitas
  namaLengkap           String        @map("nama_lengkap")
  namaPanggilan         String?       @map("nama_panggilan")
  jenisKelamin          JenisKelamin? @map("jenis_kelamin")
  tanggalLahir          DateTime?     @map("tanggal_lahir")
  alamatDomisili        String?       @map("alamat_domisili")
  telepon               String?
  tanggalPendaftaran    DateTime?     @map("tanggal_pendaftaran")
  namaPetugasPendaftar  String?       @map("nama_petugas_pendaftar")
  kontakDaruratNama     String?       @map("kontak_darurat_nama")
  kontakDaruratTelepon  String?       @map("kontak_darurat_telepon")
  kontakDaruratHubungan String?       @map("kontak_darurat_hubungan")

  desaKode       String        @map("desa_kode")
  desa           WilayahDesa   @relation(fields: [desaKode], references: [kode])
  kelompokTaniId String?       @map("kelompok_tani_id")
  kelompokTani   KelompokTani? @relation(fields: [kelompokTaniId], references: [id])

  plot         PlotPetani[]
  naungan      TanamanNaungan[]
  praktikGap   PraktikGap[]
  produksi     RiwayatProduksi[]
  produk       ProdukDijual[]
  pasar        PasarPetani[]
  kondisiKebun KondisiKebun[]

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String @map("created_by_id")

  @@index([createdById])
  @@index([desaKode])
  @@map("petani")
}

model PlotPetani {
  id       String @id @default(uuid())
  nomor    Int
  petani   Petani @relation(fields: [petaniId], references: [id], onDelete: Cascade)
  petaniId String @map("petani_id")

  namaHamparan        String?                 @map("nama_hamparan")
  varietas            String?
  tahunTanam          Int[]                   @default([]) @map("tahun_tanam")
  kodeGps             String?                 @map("kode_gps")
  elevasiMdpl         Float?                  @map("elevasi_mdpl")
  kemiringanPersen    Float?                  @map("kemiringan_persen")
  luasKopiHa          Float?                  @map("luas_kopi_ha")
  fotoKey             String?                 @map("foto_key")
  fotoLatitude        Float?                  @map("foto_latitude")
  fotoLongitude       Float?                  @map("foto_longitude")
  statusKepemilikan   StatusKepemilikanLahan? @map("status_kepemilikan")
  sistemBudidaya      SistemBudidaya?         @map("sistem_budidaya")
  areaKonservasi      String?                 @map("area_konservasi")
  tanamanBaru         Int?                    @map("tanaman_baru")
  pohonProduktif      Int?                    @map("pohon_produktif")
  pohonTidakProduktif Int?                    @map("pohon_tidak_produktif")
  pestisidaNama       String?                 @map("pestisida_nama")
  pestisidaBulanTahun String?                 @map("pestisida_bulan_tahun") // "YYYY-MM" dari input type=month

  @@index([petaniId])
  @@map("plot_petani")
}

model TanamanNaungan {
  id               String     @id @default(uuid())
  petani           Petani   @relation(fields: [petaniId], references: [id], onDelete: Cascade)
  petaniId         String   @map("petani_id")
  jenis            String?
  jumlah           Int?
  fungsi           String?
  pemangkasan      Boolean? // Apakah dilakukan pemangkasan
  produksiPerTahun String?    @map("produksi_per_tahun")
  tahunTanam       Int?       @map("tahun_tanam")

  @@index([petaniId])
  @@map("tanaman_naungan")
}

model PraktikGap {
  id         String          @id @default(uuid())
  jenis      JenisPraktikGap
  jawaban    JawabanGap?
  keterangan String?
  petani     Petani          @relation(fields: [petaniId], references: [id], onDelete: Cascade)
  petaniId   String          @map("petani_id")

  @@unique([petaniId, jenis])
  @@map("praktik_gap")
}

model RiwayatProduksi {
  id            String          @id @default(uuid())
  tahun         Int
  satuan        SatuanProduksi?
  cherry        Float?
  gabahBasah    Float?          @map("gabah_basah")
  gabahKering   Float?          @map("gabah_kering")
  greenBean     Float?          @map("green_bean")
  produktivitas Float?
  petani        Petani          @relation(fields: [petaniId], references: [id], onDelete: Cascade)
  petaniId      String          @map("petani_id")

  @@unique([petaniId, tahun])
  @@map("riwayat_produksi")
}

model ProdukDijual {
  id            String            @id @default(uuid())
  jenis         JenisProdukDijual
  labelCustom   String?           @map("label_custom")
  dijual        Boolean           @default(false)
  volumeKgTahun Float?            @map("volume_kg_tahun")
  petani        Petani            @relation(fields: [petaniId], references: [id], onDelete: Cascade)
  petaniId      String            @map("petani_id")

  @@index([petaniId])
  @@map("produk_dijual")
}

model PasarPetani {
  id            String        @id @default(uuid())
  kategori      KategoriPasar
  labelCustom   String?       @map("label_custom")
  aktif         Boolean       @default(false)
  persentase    Float?
  profilPenjual String?       @map("profil_penjual")
  petani        Petani        @relation(fields: [petaniId], references: [id], onDelete: Cascade)
  petaniId      String        @map("petani_id")

  @@index([petaniId])
  @@map("pasar_petani")
}

model KondisiKebun {
  id         String            @id @default(uuid())
  jenis      JenisKondisiKebun
  jawaban    Boolean           @default(false)
  keterangan String?
  petani     Petani            @relation(fields: [petaniId], references: [id], onDelete: Cascade)
  petaniId   String            @map("petani_id")

  @@unique([petaniId, jenis])
  @@map("kondisi_kebun")
}
