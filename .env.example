# ================================================
# Database Kopi — Environment Configuration
# Copy this file:  cp .env.example .env
# Then fill in real values for YOUR environment.
# ================================================

# --- PostgreSQL ---
# Connection string to your PostgreSQL database.
# Local:   postgresql://user:password@localhost:5432/db_name
# Managed: use the pooler URL provided by your host (e.g. Supabase).
DATABASE_URL="postgresql://user:password@localhost:5432/kopi_db"

# --- Auth ---
# NextAuth secret used to sign JWTs.
# Generate a strong random string:  openssl rand -hex 32
AUTH_SECRET="replace-with-openssl-rand-hex-32"

# --- Admin seeding ---
# Credentials for the initial admin user created by  npm run seed
ADMIN_USERNAME=caritas
ADMIN_PASSWORD="change-this-to-a-strong-password"

# --- Cloudflare R2 (photo storage) ---
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="your-bucket-name"

# --- App ---
# Public URL of the app (used for photo links inside PDF exports).
APP_URL="http://localhost:3000"
